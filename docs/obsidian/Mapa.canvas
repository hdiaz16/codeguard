{
  "nodes": [
    { "id": "titulo", "type": "text", "x": -160, "y": -640, "width": 560, "height": 90, "color": "5", "text": "# 🏔️ CodeGuard — mapa del sistema\nDel `git commit` al verde, y todo lo que pasa en medio" },

    { "id": "dev", "type": "text", "x": -640, "y": -420, "width": 220, "height": 80, "color": "5", "text": "👤 **Dev o agente IA**\n`git commit`" },
    { "id": "hook", "type": "text", "x": -340, "y": -440, "width": 260, "height": 120, "color": "2", "text": "**hook** (efímero)\n1· secretos OFFLINE\ngitleaks · fail-closed\n*nada sale a la red*" },
    { "id": "daemon", "type": "text", "x": 20, "y": -440, "width": 280, "height": 120, "color": "3", "text": "**daemon** (tray)\n2· motores en paralelo\nsemgrep · tsc · squawk · trivy\ngofmt · vet · ruff" },
    { "id": "veredicto", "type": "text", "x": 400, "y": -440, "width": 240, "height": 120, "color": "1", "text": "**VEREDICTO**\n⛔ block → el commit\nno existe\n✅ pass → commit + trailer" },

    { "id": "orbe", "type": "text", "x": 400, "y": -260, "width": 240, "height": 110, "color": "4", "text": "🔮 **orbe de plasma**\n🌫️ niebla · ❄️ ventisca\n🌿 verde salvia · 🪨 granito" },
    { "id": "panel", "type": "text", "x": 700, "y": -260, "width": 260, "height": 110, "color": "4", "text": "**panel flotante**\ncódigo señalado · pilares\n\"en palabras simples\"\nútil / falso positivo" },

    { "id": "sombra", "type": "text", "x": 20, "y": -240, "width": 280, "height": 130, "color": "6", "text": "**sombra LLM** (async, post-commit)\nriesgo ≥ 35 → redacción P5 →\n3 pilares (Kimi K3) →\nanti-alucinación → shown=0" },
    { "id": "foundry", "type": "text", "x": -340, "y": -240, "width": 260, "height": 110, "color": "6", "text": "☁️ **Azure AI Foundry**\nKimi K3 (razona, pilares)\ngpt-5.6-sol (rápido, explica)" },

    { "id": "db", "type": "text", "x": 20, "y": -60, "width": 280, "height": 100, "color": "3", "text": "🗄️ **SQLite local**\nruns · findings · feedback\nllm_calls · diff_cache" },
    { "id": "calibra", "type": "text", "x": 400, "y": -60, "width": 300, "height": 100, "color": "3", "text": "📈 **auto-calibración**\n≥5 votos + >20% FP\n→ la regla baja a aviso sola" },

    { "id": "ci", "type": "text", "x": -640, "y": -60, "width": 280, "height": 110, "color": "5", "text": "⚙️ **GitHub Actions**\nMISMO binario (paridad P3)\nsolo determinista → SARIF\ndetecta bypass por trailer" },

    { "id": "n-arq", "type": "file", "x": -640, "y": 160, "width": 300, "height": 130, "file": "Arquitectura.md" },
